# TalentPulse server settings. All are optional when running locally (python app.py).
# On AWS, set them on the ECS task / Kubernetes Deployment (see deploy/aws/README.md); the Dockerfile
# already sets the hosted defaults. Never commit a real .env file.
#
# No LinkedIn cookies are needed: searches run in each user's own browser through the extension.

# PostgreSQL connection string. Without it, a local SQLite file (sales_nav_leads.db) is used.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/talentpulse?sslmode=require

# Most database connections at once (default 15). Keep below the database's limit: 8 for Aiven's free plan.
# TALENTPULSE_DB_POOL_SIZE=8

# 1 on a shared server: turns off dry runs, the raw results log and the /docs page
# TALENTPULSE_HOSTED=1

# 0 where outgoing port 25 is blocked: emails are still found, but not checked with the mail server
# TALENTPULSE_SMTP_CHECK=0

# 0 turns email finding off entirely
# TALENTPULSE_FIND_EMAILS=1

# Timestamps in India time
# TZ=Asia/Kolkata
