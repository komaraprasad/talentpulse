{
  "manifest_version": 3,
  "name": "TalentPulse Capture",
  "version": "2.13.0",
  "description": "Sends the Sales Navigator results you are viewing to your TalentPulse dashboard (local or hosted). Makes no extra LinkedIn requests.",
  "permissions": [
    "storage",
    "scripting",
    "tabGroups"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://*.elb.amazonaws.com/*",
    "https://*.elb.amazonaws.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/sales/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "http://*.elb.amazonaws.com/*",
        "https://*.elb.amazonaws.com/*"
      ],
      "js": [
        "dashboard_bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
